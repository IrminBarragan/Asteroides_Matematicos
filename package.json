{
  "name": "portal-juegos-educativos",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de videojuegos educativos para primaria (1° a 6°). Funciona sin internet.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "pnpm test && pnpm build",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests-e2e/**/*.test.mjs\"",
    "verificar": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@fontsource/fredoka": "5.2.10",
    "@fontsource/poppins": "5.2.7",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
